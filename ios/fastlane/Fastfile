# Builds ios/RustTetris.xcodeproj (generated by XcodeGen from ios/project.yml) and uploads it to
# TestFlight, signed by hand: the distribution certificate from the keychain the workflow fills, a
# provisioning profile fastlane fetches with the App Store Connect key. Credentials come from the
# environment (.github/workflows/ios.yml). Same setup as Spell Duel's.

require "time"

default_platform(:ios)

IOS_DIR = File.expand_path("..", __dir__)
REPO_ROOT = File.expand_path("..", IOS_DIR)
PROJECT = File.join(IOS_DIR, "RustTetris.xcodeproj")
BUNDLE_ID = ENV.fetch("IOS_BUNDLE_IDENTIFIER", "com.tjonestj3.rusttetris")

def api_key_from_env
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_API_KEY_P8"),
    is_key_content_base64: true,
    in_house: false,
  )
end

# One more than TestFlight's latest, so every upload is accepted.
def next_build_number(api_key)
  latest_testflight_build_number(
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    initial_build_number: 0,
  ).to_i + 1
end

# The app signs with com.apple.developer.game-center (ios/App/RustTetris.entitlements), so the
# provisioning profile has to carry it, and Apple only puts it there when the App ID has the Game
# Center capability. The developer portal won't switch that on by hand ("add the entitlement in
# Xcode"): Xcode's automatic signing does it, and this build signs manually. So add it here with
# the App Store Connect key, once; later runs find it already on.
def ensure_game_center(_api_key)
  bundle_id = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
  UI.user_error!("No App ID #{BUNDLE_ID} in the developer portal") unless bundle_id
  if bundle_id.get_capabilities.any? { |c| c.capability_type == "GAME_CENTER" }
    UI.message("App ID #{BUNDLE_ID} has Game Center")
    return
  end
  UI.important("Adding Game Center to App ID #{BUNDLE_ID}")
  bundle_id.create_capability("GAME_CENTER")
end

platform :ios do
  desc "Write the build number this upload will get to build/next_build_number"
  lane :next_build do
    number = next_build_number(api_key_from_env)
    FileUtils.mkdir_p(File.join(REPO_ROOT, "build"))
    File.write(File.join(REPO_ROOT, "build", "next_build_number"), number.to_s)
    UI.success("Next build number #{number}")
  end

  desc "Write how old the newest TestFlight build is, in whole days, to build/testflight_age"
  # For .github/workflows/testflight-refresh.yml, which rebuilds before builds expire (90 days).
  # Runs on Linux: it only asks App Store Connect, it builds nothing. No build at all, or an
  # expired one, counts as very old.
  lane :testflight_age do
    api_key_from_env # Also signs Spaceship's App Store Connect calls in.
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app #{BUNDLE_ID} in App Store Connect") unless app
    # Usable builds only: a newer upload that failed processing doesn't stop the last good one
    # from expiring. (No `limit:`: Build.all reads every page, so a small limit means more calls.)
    newest = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      processing_states: "PROCESSING,VALID",
      sort: "-uploadedDate",
    ).first

    age =
      if newest.nil?
        UI.important("No TestFlight builds yet")
        9999
      elsif newest.expired
        UI.important("Build #{newest.version} has expired")
        9999
      else
        uploaded = Time.parse(newest.uploaded_date)
        ((Time.now - uploaded) / 86_400).floor
      end
    UI.message("Newest build: #{newest&.version || "none"}, uploaded #{newest&.uploaded_date || "never"}, expires #{newest&.expiration_date || "n/a"}")
    UI.success("TestFlight build age: #{age} days")
    FileUtils.mkdir_p(File.join(REPO_ROOT, "build"))
    File.write(File.join(REPO_ROOT, "build", "testflight_age"), age.to_s)
  end

  desc "Build, sign and upload Rust Tetris to TestFlight"
  lane :beta do
    UI.user_error!("No Xcode project at #{PROJECT}: run xcodegen in ios/ first") unless File.directory?(PROJECT)

    api_key = api_key_from_env
    team_id = ENV.fetch("APPLE_TEAM_ID")
    build_number = ENV["BUILD_NUMBER"].to_s.empty? ? next_build_number(api_key) : ENV["BUILD_NUMBER"].to_i

    ensure_game_center(api_key)
    get_provisioning_profile(api_key: api_key, app_identifier: BUNDLE_ID, force: true)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    xcargs = [
      "DEVELOPMENT_TEAM=#{team_id}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY='Apple Distribution'",
      "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
      "PRODUCT_BUNDLE_IDENTIFIER=#{BUNDLE_ID}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
    ]

    build_app(
      project: PROJECT,
      scheme: "RustTetris",
      configuration: "Release",
      export_method: "app-store",
      xcargs: xcargs.join(" "),
      export_options: {
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: { BUNDLE_ID => profile_name },
      },
      output_directory: File.join(REPO_ROOT, "build", "ipa"),
      output_name: "RustTetris.ipa",
      clean: true,
    )

    # Uploads only; an internal TestFlight group with automatic distribution picks the build up.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
    UI.success("Uploaded Rust Tetris build #{build_number}")
  end
end
